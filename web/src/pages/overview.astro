---
import Dashboard from "../layouts/Dashboard.astro";
---

<Dashboard
  title="Report Overview"
  current="overview"
  description="Campaign totals are the cities underneath. Leave the city as Default if you are not splitting yet."
>
  <div class="scopebar">
    <span class="scopebar__label" id="week-label">Week</span>
    <div class="scopebar__step">
      <button class="iconbtn iconbtn--sm" id="week-prev" type="button" aria-label="Previous week">‹</button>
      <select class="sel" id="week-select" aria-labelledby="week-label"></select>
      <button class="iconbtn iconbtn--sm" id="week-next" type="button" aria-label="Next week">›</button>
    </div>
    <span class="scopebar__spacer"></span>
    <a class="btn btn--ghost btn--sm" id="open-week" href="/weeks">Write the letter</a>
  </div>

  <p class="banner banner--ok" id="overview-ok" hidden></p>
  <p class="banner banner--bad" id="overview-error" hidden></p>

  <div class="kpis" id="kpis" hidden>
    <div class="kpi">
      <p class="kpi__label">Spend</p>
      <p class="kpi__value" data-kpi="spend">—</p>
      <p class="kpi__delta" data-delta="spend"></p>
    </div>
    <div class="kpi">
      <p class="kpi__label">Tix sold</p>
      <p class="kpi__value" data-kpi="tix">—</p>
      <p class="kpi__delta" data-delta="tix"></p>
    </div>
    <div class="kpi">
      <p class="kpi__label">CPP</p>
      <p class="kpi__value" data-kpi="cpp">—</p>
      <p class="kpi__delta" data-delta="cpp"></p>
    </div>
    <div class="kpi">
      <p class="kpi__label">Clicks</p>
      <p class="kpi__value" data-kpi="clicks">—</p>
      <p class="kpi__delta" data-delta="clicks"></p>
    </div>
  </div>

  <section class="panel">
    <div class="panel__head">
      <h2 class="panel__title">Campaigns</h2>
      <button class="btn btn--primary btn--sm" id="show-add" type="button" hidden>+ Add campaign</button>
    </div>
    <div class="tbl-wrap">
      <table class="tbl tbl--overview" id="overview-table">
        <thead>
          <tr>
            <th>Platform</th>
            <th>Campaign</th>
            <th>Status</th>
            <th class="num">Amount spent</th>
            <th class="num">Clicks</th>
            <th class="num">CPC</th>
            <th class="num">CTR</th>
            <th class="num">Tix sold</th>
            <th class="num">CPP</th>
            <th><span class="sr-only">Row actions</span></th>
          </tr>
        </thead>
        <tfoot>
          <tr class="tbl__row--add" id="add-row" hidden>
            <td><input class="inp inp--cell inp--wide" id="add-platform" value="META" aria-label="Platform" /></td>
            <td><input class="inp inp--name" id="add-name" placeholder="Campaign name" aria-label="Campaign name" /></td>
            <td>
              <select class="sel" id="add-status" aria-label="Status">
                <option value="live">Live</option>
                <option value="off">Off</option>
              </select>
            </td>
            <td class="num muted" title="Sum of the cities">—</td>
            <td class="num muted" title="Sum of the cities">—</td>
            <td></td>
            <td class="num"><input class="inp inp--cell" id="add-ctr" type="number" min="0" step="0.01" placeholder="CTR %" aria-label="CTR percent" /></td>
            <td class="num muted" title="Sum of the cities">—</td>
            <td></td>
            <td class="tbl__actions">
              <span class="tbl__rowactions">
                <button class="btn btn--primary btn--sm" id="add-save" type="button">Add</button>
                <button class="iconbtn iconbtn--sm" id="add-cancel" type="button" aria-label="Cancel">✕</button>
              </span>
            </td>
          </tr>
          <tr class="tbl__row--add tbl__row--city" id="add-city-row" hidden>
            <td></td>
            <td class="name"><span class="tbl__city"><span class="tbl__branch" aria-hidden="true"></span><input class="inp inp--name" id="add-city" placeholder="Default" aria-label="City name" /></span></td>
            <td class="muted">City</td>
            <td class="num"><input class="inp inp--cell" id="add-spent" type="number" min="0" step="0.01" placeholder="0.00" aria-label="Amount spent" /></td>
            <td class="num"><input class="inp inp--cell" id="add-clicks" type="number" min="0" step="1" placeholder="0" aria-label="Clicks" /></td>
            <td></td>
            <td></td>
            <td class="num"><input class="inp inp--cell" id="add-tix" type="number" min="0" step="1" placeholder="0" aria-label="Tix sold" /></td>
            <td></td>
            <td></td>
          </tr>
          <tr class="tbl__row--total" id="total-row" hidden data-row="total">
            <td class="name" colspan="3">Total</td>
            <td class="num" data-cell="amount_spent">—</td>
            <td class="num" data-cell="clicks">—</td>
            <td class="num" data-cell="cpc">—</td>
            <td></td>
            <td class="num" data-cell="tix_sold">—</td>
            <td class="num" data-cell="cpp">—</td>
            <td></td>
          </tr>
        </tfoot>
      </table>
    </div>
    <div class="empty empty--overview" id="overview-empty" hidden>
      <p class="empty__title">No week selected</p>
      <p class="empty__desc">Create a week, then add a campaign.</p>
      <p class="empty__action"><a class="btn btn--primary btn--sm" href="/weeks">Create a week</a></p>
    </div>
  </section>
</Dashboard>

<script>
  import { api, type Overview } from "../lib/api";
  import { money, percent, percentInput, whole, escapeHtml } from "../lib/format";

  type Group = Overview["groups"][number];
  type Row = Group["campaigns"][number];
  type City = Row["locations"][number];

  const weekSelect = document.getElementById("week-select") as HTMLSelectElement;
  const weekPrev = document.getElementById("week-prev") as HTMLButtonElement;
  const weekNext = document.getElementById("week-next") as HTMLButtonElement;
  const openWeek = document.getElementById("open-week") as HTMLAnchorElement;
  const table = document.getElementById("overview-table") as HTMLTableElement;
  const tfoot = table.tFoot!;
  const totalRow = document.getElementById("total-row") as HTMLTableRowElement;
  const empty = document.getElementById("overview-empty") as HTMLElement;
  const emptyTitle = empty.querySelector(".empty__title") as HTMLElement;
  const emptyDesc = empty.querySelector(".empty__desc") as HTMLElement;
  const emptyAction = empty.querySelector(".empty__action") as HTMLElement;
  const kpis = document.getElementById("kpis") as HTMLElement;
  const error = document.getElementById("overview-error") as HTMLElement;
  const ok = document.getElementById("overview-ok") as HTMLElement;
  const addRow = document.getElementById("add-row") as HTMLTableRowElement;
  const addCityRow = document.getElementById("add-city-row") as HTMLTableRowElement;
  const showAdd = document.getElementById("show-add") as HTMLButtonElement;
  const params = new URLSearchParams(location.search);

  let currentWeekId: number | null = null;
  let hasRows = false;

  const addFields = {
    platform: document.getElementById("add-platform") as HTMLInputElement,
    name: document.getElementById("add-name") as HTMLInputElement,
    status: document.getElementById("add-status") as HTMLSelectElement,
    city: document.getElementById("add-city") as HTMLInputElement,
    spent: document.getElementById("add-spent") as HTMLInputElement,
    clicks: document.getElementById("add-clicks") as HTMLInputElement,
    ctr: document.getElementById("add-ctr") as HTMLInputElement,
    tix: document.getElementById("add-tix") as HTMLInputElement,
  };

  /* ---------- messages ---------- */

  function showError(message: string) {
    ok.hidden = true;
    error.hidden = false;
    error.textContent = message.replace(/^Error:\s*/, "");
  }

  function showOk(message: string) {
    error.hidden = true;
    ok.hidden = false;
    ok.textContent = message;
    window.setTimeout(() => {
      if (ok.textContent === message) ok.hidden = true;
    }, 2600);
  }

  function flashSaved(el: Element) {
    el.classList.remove("is-invalid");
    el.classList.add("is-saved");
    window.setTimeout(() => el.classList.remove("is-saved"), 1000);
  }

  /* ---------- KPI deltas ---------- */

  function deltaText(
    current: number | null,
    previous: number | null,
    label: string,
    lowerIsBetter: boolean,
  ): { text: string; tone: string } {
    if (current == null || previous == null || previous === 0) return { text: `no ${label} figure`, tone: "" };
    const change = ((current - previous) / previous) * 100;
    if (Math.abs(change) < 0.05) return { text: `level with ${label}`, tone: "" };
    const up = change > 0;
    const better = lowerIsBetter ? !up : up;
    return {
      text: `${up ? "↑" : "↓"} ${Math.abs(change).toFixed(1)}% vs ${label}`,
      tone: better ? "kpi__delta--good" : "kpi__delta--bad",
    };
  }

  function renderKpis(overview: Overview) {
    const totals = overview.totals;
    kpis.querySelector('[data-kpi="spend"]')!.textContent = money(totals.amount_spent);
    kpis.querySelector('[data-kpi="tix"]')!.textContent = whole(totals.tix_sold);
    kpis.querySelector('[data-kpi="cpp"]')!.textContent = money(totals.cpp);
    kpis.querySelector('[data-kpi="clicks"]')!.textContent = whole(totals.clicks);

    const prior = overview.previous;
    const specs: [string, number | null, boolean][] = [
      ["spend", totals.amount_spent, false],
      ["tix", totals.tix_sold, false],
      ["cpp", totals.cpp, true],
      ["clicks", totals.clicks, false],
    ];
    const priorValue: Record<string, number | null> = prior
      ? {
          spend: prior.totals.amount_spent,
          tix: prior.totals.tix_sold,
          cpp: prior.totals.cpp,
          clicks: prior.totals.clicks,
        }
      : {};
    for (const [key, now, lowerIsBetter] of specs) {
      const el = kpis.querySelector(`[data-delta="${key}"]`) as HTMLElement;
      if (!prior) {
        el.textContent = "first week on record";
        el.className = "kpi__delta";
        continue;
      }
      const result = deltaText(now, priorValue[key] ?? null, prior.label, lowerIsBetter);
      el.textContent = result.text;
      el.className = `kpi__delta ${result.tone}`.trim();
    }
  }

  /* ---------- cell values ---------- */

  type Kind = "money" | "int" | "pct" | "text";

  function display(kind: Kind, value: unknown): string {
    if (kind === "money") return money((value as number) ?? 0);
    if (kind === "pct") return percent(value as number | null);
    if (kind === "text") return String(value ?? "");
    return whole((value as number) ?? 0);
  }

  // CTR is stored as a fraction but typed as a percentage, so raw and display differ.
  function rawFor(kind: Kind, value: unknown): string {
    if (kind === "pct") return percentInput(value as number | null);
    if (kind === "text") return String(value ?? "");
    return String((value as number) ?? 0);
  }

  /** A value that reads as plain text and only becomes an input once clicked. */
  function editable(
    owner: "campaign" | "location",
    id: number,
    field: string,
    value: unknown,
    kind: Kind,
    label: string,
  ): string {
    const step = kind === "money" || kind === "pct" ? "0.01" : "1";
    return `<span class="cellv" role="button" tabindex="0" title="Click to edit" data-${owner}="${id}" data-field="${field}" data-kind="${kind}" data-step="${step}" data-raw="${escapeHtml(rawFor(kind, value))}" aria-label="${escapeHtml(label)}">${escapeHtml(display(kind, value))}</span>`;
  }

  function rolled(kind: Kind, value: unknown, label: string): string {
    return `<span class="tbl__rolled" title="${escapeHtml(label)}">${escapeHtml(display(kind, value))}</span>`;
  }

  function branch(): string {
    return `<span class="tbl__branch" aria-hidden="true"></span>`;
  }

  function statusPill(id: number, status: string): string {
    const live = status === "live";
    const next = live ? "Off" : "Live";
    return `<button class="pill pill--btn ${live ? "pill--ok" : ""}" type="button" data-status="${id}" data-now="${status}" title="Click to switch to ${next}" aria-label="Status ${live ? "Live" : "Off"}, click to switch to ${next}">${live ? "Live" : "Off"}</button>`;
  }

  function campaignRow(campaign: Row): string {
    const hasCities = campaign.locations.length > 0;
    const id = campaign.id;
    const safe = escapeHtml(campaign.name);
    const count = campaign.locations.length;
    const countLabel = hasCities ? `<span class="tbl__count">${count} ${count === 1 ? "city" : "cities"}</span>` : "";
    const addCity = `<button class="tbl__addcity tbl__addcity--row" data-city-toggle="${id}" type="button">Add city</button>`;
    return `
      <tr data-row="c${id}" class="${hasCities ? "tbl__row--parent" : ""}">
        <td>${editable("campaign", id, "platform", campaign.platform, "text", `Platform for ${campaign.name}`)}</td>
        <td class="name">${editable("campaign", id, "name", campaign.name, "text", "Campaign name")}${countLabel}</td>
        <td>${statusPill(id, campaign.status)}</td>
        <td class="num" data-cell="amount_spent">${rolled("money", campaign.amount_spent, "Total of the cities below")}</td>
        <td class="num" data-cell="clicks">${rolled("int", campaign.clicks ?? 0, "Total of the cities below")}</td>
        <td class="num" data-cell="cpc">${rolled("money", campaign.cpc, "Calculated")}</td>
        <td class="num" data-cell="ctr">${editable("campaign", id, "ctr", campaign.ctr, "pct", `CTR for ${campaign.name}`)}</td>
        <td class="num" data-cell="tix_sold">${rolled("int", campaign.tix_sold ?? 0, "Total of the cities below")}</td>
        <td class="num" data-cell="cpp">${rolled("money", campaign.cpp, "Calculated")}</td>
        <td class="tbl__actions">
          ${addCity}
          <span class="tbl__rowactions">
            <button class="iconbtn iconbtn--sm iconbtn--danger" data-remove-campaign="${id}" type="button" title="Remove from this week" aria-label="Remove ${safe} from this week">✕</button>
          </span>
        </td>
      </tr>`;
  }

  function cityRow(loc: City): string {
    const safe = escapeHtml(loc.name);
    return `
      <tr class="tbl__row--city" data-row="l${loc.id}">
        <td></td>
        <td class="name"><span class="tbl__city">${branch()}${editable("location", loc.id, "name", loc.name, "text", "City name")}</span></td>
        <td class="muted">City</td>
        <td class="num" data-cell="amount_spent">${editable("location", loc.id, "amount_spent", loc.amount_spent, "money", `Spend for ${loc.name}`)}</td>
        <td class="num" data-cell="clicks">${editable("location", loc.id, "clicks", loc.clicks, "int", `Clicks for ${loc.name}`)}</td>
        <td class="num" data-cell="cpc">${rolled("money", loc.cpc, "Calculated")}</td>
        <td></td>
        <td class="num" data-cell="tix_sold">${editable("location", loc.id, "tix_sold", loc.tix_sold, "int", `Tix sold for ${loc.name}`)}</td>
        <td class="num" data-cell="cpp">${rolled("money", loc.cpp, "Calculated")}</td>
        <td class="tbl__actions">
          <span class="tbl__rowactions">
            <button class="iconbtn iconbtn--sm iconbtn--danger" data-remove-location="${loc.id}" type="button" title="Delete this city" aria-label="Delete ${safe}">✕</button>
          </span>
        </td>
      </tr>`;
  }

  function cityFormRow(campaignId: number): string {
    return `
      <tr class="tbl__row--city tbl__row--add" data-city-form="${campaignId}" hidden>
        <td></td>
        <td class="name"><span class="tbl__city">${branch()}<input class="inp inp--name" name="name" placeholder="City name" aria-label="New city name"></span></td>
        <td></td>
        <td class="num"><input class="inp inp--cell" name="amount_spent" type="number" min="0" step="0.01" placeholder="0.00" aria-label="City spend"></td>
        <td class="num"><input class="inp inp--cell" name="clicks" type="number" min="0" step="1" placeholder="0" aria-label="City clicks"></td>
        <td></td>
        <td></td>
        <td class="num"><input class="inp inp--cell" name="tix_sold" type="number" min="0" step="1" placeholder="0" aria-label="City tix sold"></td>
        <td></td>
        <td class="tbl__actions">
          <span class="tbl__rowactions">
            <button class="btn btn--primary btn--sm" data-city-save="${campaignId}" type="button">Add</button>
            <button class="iconbtn iconbtn--sm" data-city-cancel="${campaignId}" type="button" aria-label="Close add city">✕</button>
          </span>
        </td>
      </tr>`;
  }

  function openCityForm(campaignId: string) {
    const form = table.querySelector<HTMLTableRowElement>(`[data-city-form="${campaignId}"]`);
    if (!form) return;
    form.hidden = false;
    (form.querySelector('[name="name"]') as HTMLInputElement)?.focus();
  }

  function closeCityForm(campaignId: string) {
    const form = table.querySelector<HTMLTableRowElement>(`[data-city-form="${campaignId}"]`);
    if (!form) return;
    form.querySelectorAll("input").forEach((input) => {
      input.value = "";
    });
    form.hidden = true;
  }

  function clearBlocks() {
    table.querySelectorAll("tbody.tbl__block").forEach((el) => el.remove());
  }

  /* ---------- full render ---------- */

  function render(overview: Overview) {
    const hasWeek = Boolean(overview.week);
    hasRows = overview.groups.some((group) => group.campaigns.length > 0);
    kpis.hidden = !hasWeek;
    showAdd.hidden = !hasWeek || !addRow.hidden;
    clearBlocks();
    if (!hasWeek) {
      emptyTitle.textContent = "No week selected";
      emptyDesc.textContent = "Create a week, then add a campaign.";
      emptyAction.hidden = false;
      empty.hidden = false;
      totalRow.hidden = true;
      addRow.hidden = true;
      addCityRow.hidden = true;
      (table.closest(".tbl-wrap") as HTMLElement).hidden = true;
      return;
    }
    if (!hasRows) {
      emptyTitle.textContent = "No campaigns in this week yet";
      emptyDesc.textContent = "Add the first campaign to start the table.";
      emptyAction.hidden = true;
    }
    empty.hidden = hasRows || !addRow.hidden;
    const wrap = table.closest(".tbl-wrap") as HTMLElement;
    wrap.hidden = !hasRows && addRow.hidden;
    renderKpis(overview);

    for (const group of overview.groups) {
      for (const campaign of group.campaigns) {
        const hasCities = campaign.locations.length > 0;
        const block = document.createElement("tbody");
        block.className = hasCities ? "tbl__block tbl__block--split" : "tbl__block";
        const parts = [campaignRow(campaign)];
        for (const loc of campaign.locations) parts.push(cityRow(loc));
        parts.push(cityFormRow(campaign.id));
        block.innerHTML = parts.join("");
        table.insertBefore(block, tfoot);
      }
    }
    totalRow.hidden = !hasRows;
    if (hasRows) {
      setCell("total", "amount_spent", overview.totals.amount_spent, "money");
      setCell("total", "clicks", overview.totals.clicks, "int");
      setCell("total", "cpc", overview.totals.cpc, "money");
      setCell("total", "tix_sold", overview.totals.tix_sold, "int");
      setCell("total", "cpp", overview.totals.cpp, "money");
    }
    bindRows(overview.week!.id);
  }

  /* ---------- targeted refresh (keeps focus and tab order) ---------- */

  function setCell(rowKey: string, name: string, value: unknown, kind: Kind) {
    const td = table.querySelector<HTMLElement>(`[data-row="${rowKey}"] [data-cell="${name}"]`);
    if (!td || td.querySelector("input")) return;
    const span = td.querySelector<HTMLElement>(".cellv, .tbl__rolled");
    if (span) {
      if (span.classList.contains("cellv")) span.dataset.raw = rawFor(kind, value);
      span.textContent = display(kind, value);
      return;
    }
    td.textContent = display(kind, value);
  }

  function refreshDerived(overview: Overview) {
    renderKpis(overview);
    overview.groups.forEach((group) => {
      for (const campaign of group.campaigns) {
        const key = `c${campaign.id}`;
        setCell(key, "amount_spent", campaign.amount_spent, "money");
        setCell(key, "clicks", campaign.clicks ?? 0, "int");
        setCell(key, "cpc", campaign.cpc, "money");
        setCell(key, "ctr", campaign.ctr, "pct");
        setCell(key, "tix_sold", campaign.tix_sold ?? 0, "int");
        setCell(key, "cpp", campaign.cpp, "money");
        for (const loc of campaign.locations) {
          const city = `l${loc.id}`;
          setCell(city, "amount_spent", loc.amount_spent, "money");
          setCell(city, "clicks", loc.clicks ?? 0, "int");
          setCell(city, "cpc", loc.cpc, "money");
          setCell(city, "tix_sold", loc.tix_sold ?? 0, "int");
          setCell(city, "cpp", loc.cpp, "money");
        }
      }
    });
    setCell("total", "amount_spent", overview.totals.amount_spent, "money");
    setCell("total", "clicks", overview.totals.clicks, "int");
    setCell("total", "cpc", overview.totals.cpc, "money");
    setCell("total", "tix_sold", overview.totals.tix_sold, "int");
    setCell("total", "cpp", overview.totals.cpp, "money");
  }

  /* ---------- editing ---------- */

  const REGROUPING = new Set(["name"]);

  function pathFor(el: HTMLElement): string {
    return el.dataset.campaign
      ? `/api/weeks/${currentWeekId}/campaigns/${el.dataset.campaign}`
      : `/api/weeks/${currentWeekId}/locations/${el.dataset.location}`;
  }

  /** Returns true when the value was accepted, so the caller can restore the text. */
  async function saveField(span: HTMLElement, input: HTMLInputElement): Promise<boolean> {
    const field = span.dataset.field!;
    const kind = span.dataset.kind as Kind;
    const value = kind === "text" ? input.value.trim() : Number(input.value) || 0;
    try {
      const updated = await api<Overview>(pathFor(span), {
        method: "PATCH",
        body: JSON.stringify({ [field]: value }),
      });
      error.hidden = true;
      if (REGROUPING.has(field)) {
        render(updated);
        const fresh = table.querySelector(
          `[data-field="${field}"][data-${span.dataset.campaign ? "campaign" : "location"}="${span.dataset.campaign || span.dataset.location}"]`,
        );
        if (fresh) flashSaved(fresh);
        return true;
      }
      span.dataset.raw = rawFor(kind, value);
      span.textContent = display(kind, value);
      input.replaceWith(span);
      refreshDerived(updated);
      flashSaved(span);
      return true;
    } catch (err) {
      input.classList.add("is-invalid");
      showError(String(err));
      return false;
    }
  }

  /** Swaps a text cell for an input, committing on blur or Enter and reverting on Escape. */
  function beginEdit(span: HTMLElement) {
    if (!currentWeekId) return;
    const kind = span.dataset.kind as Kind;
    const input = document.createElement("input");
    input.className = kind === "text" ? "inp inp--name" : "inp inp--cell";
    input.setAttribute("aria-label", span.getAttribute("aria-label") || span.dataset.field!);
    if (kind === "text") {
      input.type = "text";
    } else {
      input.type = "number";
      input.min = "0";
      input.step = span.dataset.step || "1";
    }
    input.value = span.dataset.raw || "";

    let settled = false;
    const revert = () => {
      if (settled) return;
      settled = true;
      input.replaceWith(span);
    };
    const commit = async () => {
      if (settled) return;
      settled = true;
      if (input.value === (span.dataset.raw || "")) {
        input.replaceWith(span);
        return;
      }
      if (!(await saveField(span, input))) {
        settled = false;
        input.focus();
      }
    };

    input.addEventListener("blur", () => void commit());
    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter") {
        event.preventDefault();
        input.blur();
      }
      if (event.key === "Escape") {
        event.preventDefault();
        revert();
        span.focus();
      }
    });

    span.replaceWith(input);
    input.focus();
    input.select();
  }

  async function toggleStatus(button: HTMLButtonElement) {
    if (!currentWeekId) return;
    const next = button.dataset.now === "live" ? "off" : "live";
    try {
      const updated = await api<Overview>(`/api/weeks/${currentWeekId}/campaigns/${button.dataset.status}`, {
        method: "PATCH",
        body: JSON.stringify({ status: next }),
      });
      error.hidden = true;
      render(updated);
    } catch (err) {
      showError(String(err));
    }
  }

  // Cells are swapped in and out of the DOM, so edit intent is handled by delegation.
  table.addEventListener("click", (event) => {
    const target = event.target as HTMLElement;
    if (target.closest("tfoot")) return;
    const pill = target.closest<HTMLButtonElement>("[data-status]");
    if (pill) {
      void toggleStatus(pill);
      return;
    }
    const span = target.closest<HTMLElement>(".cellv");
    if (span) beginEdit(span);
  });

  table.addEventListener("keydown", (event) => {
    if (event.key !== "Enter" && event.key !== " ") return;
    const span = (event.target as HTMLElement).closest<HTMLElement>(".cellv");
    if (!span || span.closest("tfoot")) return;
    event.preventDefault();
    beginEdit(span);
  });

  function bindRows(weekId: number) {
    table.querySelectorAll<HTMLButtonElement>("[data-city-toggle]").forEach((button) => {
      button.addEventListener("click", () => openCityForm(button.dataset.cityToggle || ""));
    });

    table.querySelectorAll<HTMLButtonElement>("[data-city-save]").forEach((button) => {
      const form = table.querySelector<HTMLTableRowElement>(`[data-city-form="${button.dataset.citySave}"]`)!;
      const read = (name: string) => (form.querySelector(`[name="${name}"]`) as HTMLInputElement).value;
      const save = async () => {
        const name = read("name").trim();
        if (!name) {
          showError("Give the city a name.");
          return;
        }
        const campaignId = button.dataset.citySave || "";
        const firstCity = !form.closest("tbody")?.querySelector(".tbl__row--city[data-row]");
        try {
          const updated = await api<Overview>(`/api/weeks/${weekId}/campaigns/${campaignId}/locations`, {
            method: "POST",
            body: JSON.stringify({
              name,
              amount_spent: read("amount_spent") === "" ? null : Number(read("amount_spent")),
              clicks: read("clicks") === "" ? null : Number(read("clicks")),
              tix_sold: read("tix_sold") === "" ? null : Number(read("tix_sold")),
            }),
          });
          render(updated);
          showOk(
            firstCity
              ? `Added ${name}. This campaign's numbers now live on the city lines.`
              : `Added ${name}.`,
          );
        } catch (err) {
          showError(String(err));
        }
      };
      button.addEventListener("click", save);
      form.querySelector<HTMLButtonElement>("[data-city-cancel]")?.addEventListener("click", () => {
        closeCityForm(button.dataset.citySave || "");
      });
      form.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
          event.preventDefault();
          save();
        }
        if (event.key === "Escape") {
          event.preventDefault();
          closeCityForm(button.dataset.citySave || "");
        }
      });
    });

    table.querySelectorAll<HTMLButtonElement>("[data-remove-campaign]").forEach((button) => {
      button.addEventListener("click", async () => {
        const row = button.closest("tr")!;
        const name = row.querySelector('[data-field="name"]')?.textContent?.trim() || "this campaign";
        if (!confirm(`Remove "${name}" from this week?\n\nIt stays on other weeks. You can add it back here later.`)) return;
        try {
          const updated = await api<Overview>(`/api/weeks/${weekId}/campaigns/${button.dataset.removeCampaign}`, {
            method: "DELETE",
          });
          render(updated);
          showOk(`Removed ${name} from this week.`);
        } catch (err) {
          showError(String(err));
        }
      });
    });

    table.querySelectorAll<HTMLButtonElement>("[data-remove-location]").forEach((button) => {
      button.addEventListener("click", async () => {
        const row = button.closest("tr")!;
        const name = row.querySelector('[data-field="name"]')?.textContent?.trim() || "this city";
        if (!confirm(`Delete the city "${name}"?\n\nIt is removed from every week, not just this one.`)) return;
        try {
          const updated = await api<Overview>(`/api/weeks/${weekId}/locations/${button.dataset.removeLocation}`, {
            method: "DELETE",
          });
          render(updated);
          showOk(`Deleted ${name}.`);
        } catch (err) {
          showError(String(err));
        }
      });
    });
  }

  /* ---------- add campaign ---------- */

  function openAddRow(open: boolean) {
    addRow.hidden = !open;
    addCityRow.hidden = !open;
    showAdd.hidden = open;
    empty.hidden = open || hasRows;
    const wrap = table.closest(".tbl-wrap") as HTMLElement;
    wrap.hidden = !hasRows && addRow.hidden;
    if (open) addFields.name.focus();
  }

  function resetAddRow() {
    addFields.platform.value = "META";
    addFields.name.value = "";
    addFields.status.value = "live";
    addFields.city.value = "";
    addFields.spent.value = "";
    addFields.clicks.value = "";
    addFields.ctr.value = "";
    addFields.tix.value = "";
    addFields.name.classList.remove("is-invalid");
  }

  async function submitAddRow() {
    if (!currentWeekId) {
      showError("Create a week first.");
      return;
    }
    const name = addFields.name.value.trim();
    if (!name) {
      addFields.name.classList.add("is-invalid");
      addFields.name.focus();
      showError("Give the campaign a name.");
      return;
    }
    const city = addFields.city.value.trim() || "Default";
    try {
      const updated = await api<Overview>(`/api/weeks/${currentWeekId}/campaigns`, {
        method: "POST",
        body: JSON.stringify({
          platform: addFields.platform.value.trim() || "META",
          name,
          status: addFields.status.value,
          city,
          amount_spent: Number(addFields.spent.value) || 0,
          clicks: Number(addFields.clicks.value) || 0,
          ctr: addFields.ctr.value === "" ? null : Number(addFields.ctr.value),
          tix_sold: Number(addFields.tix.value) || 0,
        }),
      });
      render(updated);
      resetAddRow();
      openAddRow(true);
      showOk(`Added ${name} · ${city}. Add another, or press Escape to close.`);
    } catch (err) {
      showError(String(err));
    }
  }

  /* ---------- week scope ---------- */

  function updateStepper() {
    const index = weekSelect.selectedIndex;
    weekPrev.disabled = index < 0 || index >= weekSelect.options.length - 1;
    weekNext.disabled = index <= 0;
  }

  async function loadOverview(weekId?: number) {
    const query = weekId ? `?week_id=${weekId}` : "";
    const overview = await api<Overview>(`/api/overview${query}`);
    render(overview);
    if (overview.week) {
      currentWeekId = overview.week.id;
      weekSelect.value = String(overview.week.id);
      openWeek.href = `/weeks/detail?id=${overview.week.id}`;
    } else {
      currentWeekId = null;
    }
    updateStepper();
  }

  function selectWeek(id: number) {
    history.replaceState(null, "", id ? `/overview?week=${id}` : "/overview");
    ok.hidden = true;
    error.hidden = true;
    loadOverview(id).catch((err) => showError(String(err)));
  }

  function stepWeek(offset: number) {
    const next = weekSelect.selectedIndex + offset;
    if (next < 0 || next >= weekSelect.options.length) return;
    weekSelect.selectedIndex = next;
    selectWeek(Number(weekSelect.value));
  }

  showAdd.addEventListener("click", () => openAddRow(true));
  document.getElementById("add-cancel")!.addEventListener("click", () => {
    resetAddRow();
    openAddRow(false);
  });
  document.getElementById("add-save")!.addEventListener("click", () => submitAddRow());
  function onAddKey(event: KeyboardEvent) {
    if (event.key === "Enter") {
      event.preventDefault();
      submitAddRow();
    }
    if (event.key === "Escape") {
      resetAddRow();
      openAddRow(false);
    }
  }
  addRow.addEventListener("keydown", onAddKey);
  addCityRow.addEventListener("keydown", onAddKey);

  weekSelect.addEventListener("change", () => selectWeek(Number(weekSelect.value)));
  // Options are newest first, so the older week sits further down the list.
  weekPrev.addEventListener("click", () => stepWeek(1));
  weekNext.addEventListener("click", () => stepWeek(-1));

  async function boot() {
    const { weeks } = await api<{ weeks: { id: number; label?: string; updated_until: string | null; period_end: string }[] }>(
      "/api/weeks",
    );
    weekSelect.innerHTML = weeks
      .map((week) => `<option value="${week.id}">${week.label || week.updated_until || week.period_end}</option>`)
      .join("");
    const requested = Number(params.get("week") || "");
    await loadOverview(requested || undefined);
  }

  boot().catch((err) => showError(String(err)));
</script>
