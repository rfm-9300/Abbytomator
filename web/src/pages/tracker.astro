---
import Dashboard from "../layouts/Dashboard.astro";
---

<Dashboard
  title="Live Ads Tracker"
  current="tracker"
  description="What is live and what is off. Import the Meta CSV on Overview; you can override status here until the next import."
>
  <section class="panel">
    <div class="panel__head">
      <h2 class="panel__title">Campaigns</h2>
      <div class="row">
        <select class="sel" id="status-filter">
          <option value="">All</option>
          <option value="live">Live</option>
          <option value="off">Off</option>
        </select>
      </div>
    </div>
    <div class="panel__body">
    <p class="hint" id="import-stamp"></p>
    </div>
    <div class="tbl-wrap">
      <table class="tbl" id="tracker-table">
        <thead>
          <tr>
            <th>Status</th>
            <th>Platform</th>
            <th>Campaign</th>
            <th>Event</th>
            <th>Cities</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </div>
    <div class="empty empty--tracker" id="tracker-empty" hidden>
      <p class="empty__title">No campaigns yet</p>
      <p class="empty__desc">Import a Meta CSV on Overview.</p>
    </div>
  </section>
</Dashboard>

<script>
  import { api, type Campaign } from "../lib/api";
  import { escapeHtml } from "../lib/format";

  const tbody = document.querySelector("#tracker-table tbody") as HTMLTableSectionElement;
  const empty = document.getElementById("tracker-empty") as HTMLElement;
  const stamp = document.getElementById("import-stamp") as HTMLElement;
  const filter = document.getElementById("status-filter") as HTMLSelectElement;
  let rows: Campaign[] = [];
  let lastImport: string | null = null;

  function render() {
    const status = filter.value;
    const visible = status ? rows.filter((row) => row.status === status) : rows;
    tbody.innerHTML = visible
      .map(
        (row) => `
      <tr>
        <td>
          <select class="sel" data-status="${row.id}">
            <option value="live" ${row.status === "live" ? "selected" : ""}>Live</option>
            <option value="off" ${row.status === "off" ? "selected" : ""}>Off</option>
          </select>
        </td>
        <td class="muted">${escapeHtml(row.platform)}</td>
        <td class="name">${escapeHtml(row.name)}</td>
        <td><input class="inp" data-event="${row.id}" value="${escapeHtml(row.event_label)}"></td>
        <td>
          <span class="muted">${row.locations.map((loc) => escapeHtml(loc.name)).join(", ") || "—"}</span>
          <form class="row" data-add-city="${row.id}">
            <input class="inp inp--cell" name="name" placeholder="Add city" required>
            <button class="btn btn--ghost btn--sm" type="submit">Add</button>
          </form>
        </td>
      </tr>`
      )
      .join("");
    empty.hidden = visible.length > 0;
    stamp.textContent = lastImport ? `Last Meta import: ${new Date(lastImport).toLocaleString("en-GB")}` : "No CSV imported yet.";
    tbody.querySelectorAll<HTMLSelectElement>("[data-status]").forEach((select) => {
      select.addEventListener("change", async () => {
        const id = Number(select.dataset.status);
        await api(`/api/campaigns/${id}`, {
          method: "PATCH",
          body: JSON.stringify({ status: select.value }),
        });
        await load();
      });
    });
    tbody.querySelectorAll<HTMLInputElement>("[data-event]").forEach((input) => {
      input.addEventListener("change", async () => {
        await api(`/api/campaigns/${input.dataset.event}`, {
          method: "PATCH",
          body: JSON.stringify({ event_label: input.value }),
        });
        await load();
      });
    });
    tbody.querySelectorAll<HTMLFormElement>("[data-add-city]").forEach((form) => {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const name = (form.elements.namedItem("name") as HTMLInputElement).value;
        await api(`/api/campaigns/${form.dataset.addCity}/locations`, {
          method: "POST",
          body: JSON.stringify({ name }),
        });
        await load();
      });
    });
  }

  async function load() {
    const data = await api<{ last_imported_at: string | null; campaigns: Campaign[] }>("/api/campaigns");
    rows = data.campaigns;
    lastImport = data.last_imported_at;
    render();
  }

  filter.addEventListener("change", render);
  load().catch((err) => {
    stamp.textContent = String(err);
  });
</script>
